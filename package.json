{
  "name": "@automaited/electron-forge-gitlab-publisher",
  "version": "0.1.0",
  "description": "Electron Forge publisher for GitLab releases, including generic package uploads, release asset links, and direct asset paths for private auto-update feeds.",
  "license": "MIT",
  "author": "automaited (aiConomix GmbH) <opensource@automaited.com>",
  "main": "dist/PublisherGitLab.js",
  "typings": "dist/PublisherGitLab.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "electron",
    "electron-forge",
    "electron-forge-publisher",
    "gitlab",
    "publisher",
    "release"
  ],
  "engines": {
    "node": ">=16.4.0"
  },
  "dependencies": {
    "debug": "^4.3.1",
    "fs-extra": "^10.0.0",
    "mime-types": "^2.1.35",
    "node-fetch": "^2.7.0"
  },
  "peerDependencies": {
    "@electron-forge/publisher-base": "^7.0.0 || ^8.0.0-alpha"
  },
  "devDependencies": {
    "@electron-forge/publisher-base": "^7.11.1",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^9.0.13",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^18.19.0",
    "@types/node-fetch": "^2.6.12",
    "typescript": "^5.4.5",
    "vitest": "^3.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/automaited/electron-forge-gitlab-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/automaited/electron-forge-gitlab-publisher/issues"
  },
  "homepage": "https://github.com/automaited/electron-forge-gitlab-publisher#readme"
}
